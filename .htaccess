Options -Indexes -MultiViews

RewriteEngine On

# Preserve Authorization header across internal rewrites to PHP.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Never expose dotfiles or internal repo folders directly.
RewriteRule (^|/)\. - [F,END]
RewriteRule ^(?:backend|docs|frontend|skills|tools|var)(?:/|$) - [F,END]
RewriteRule ^(?:AGENTS|CONTRIBUTING|INSTALL|README)\.md$ - [F,END]

# Canonical backend entrypoints under the same origin.
RewriteRule ^(?:api/.*|health)$ backend/public/index.php [QSA,END]

# Frontend browser tests are available only when Apache enables dev mode.
RewriteRule ^tests/(.*)$ frontend/tests/$1 [END]

# Canonical frontend static assets.
RewriteRule ^css/(.*)$ frontend/src/css/$1 [END]
RewriteRule ^js/(.*)$ frontend/src/js/$1 [END]

# Plugin frontend assets.
RewriteRule ^plugins/([^/]+)/plugin\.js$ plugins/$1/plugin.js [END]
RewriteRule ^plugins/([^/]+)/assets/(.*)$ plugins/$1/assets/$2 [END]
RewriteRule ^plugins/ - [F,END]

# SPA shell.
RewriteRule ^$ frontend/src/index.html [END]
RewriteRule . frontend/src/index.html [END]
